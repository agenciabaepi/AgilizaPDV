{
  "installCommand": "npm ci --ignore-scripts --prefix api && npm rebuild libxmljs2 --prefix api && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/fiscal/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/node_modules/**"
    },
    "api/assinaturas/**/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/saas/**/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/loja-online/**/*.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/loja-online/sincronizar-pagamentos?cron=1",
      "schedule": "0 3 * * *"
    }
  ]
}
