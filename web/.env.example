# Copie para .env.local e preencha com os dados do projeto Supabase
# Supabase > Project Settings > API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public

# Obrigatório para o painel SaaS em dev (copie também para .env.local sem prefixo VITE_)
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role — não use o texto "sua-service-role-key")

# Domínio base para subdomínios da loja online (ex.: minhaloja.agilizapdv.app)
VITE_LOJA_ONLINE_DOMAIN=agilizapdv.app

# --- Loja online — domínio próprio (HTTPS via Vercel) ---
# Token em https://vercel.com/account/tokens com permissão do projeto.
# No Vercel, VERCEL_PROJECT_ID e VERCEL_TEAM_ID já existem; basta cadastrar VERCEL_TOKEN.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Chave opcional para criptografar senhas de certificado A1 (recomendado em produção)
# VITE_CERT_ENCRYPT_KEY=sua-chave-secreta-longa

# Em desenvolvimento local, o Vite encaminha /api/* para esta URL (padrão: produção)
# VITE_FISCAL_API_BASE=https://agilizapdv.app

# --- Assinaturas (Asaas) — variáveis do SERVIDOR (Vercel / api/assinaturas) ---
# Para dev local: copie estas linhas para web/.env.local (sem prefixo VITE_)
# A chave Asaas começa com $ — use \$ no .env.local (ex.: ASAAS_API_KEY=\$aact_prod_...)

# ASAAS_API_KEY=\$sua-chave-api-asaas
# ASAAS_API_BASE=https://api.asaas.com
# ASAAS_WEBHOOK_TOKEN=token-configurado-no-painel-asaas
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# ASSINATURA_VALOR_MENSAL=5.00
# ASSINATURA_TRIAL_DIAS=7

# --- Painel SaaS (gestão de empresas / assinaturas) — servidor ---
# Gere um token longo e aleatório para SAAS_ADMIN_TOKEN
# SAAS_ADMIN_EMAIL=admin@agilizapdv.app
# SAAS_ADMIN_PASSWORD=sua-senha-forte
# SAAS_ADMIN_TOKEN=token-longo-aleatorio-para-api

# --- Loja online — frete via Melhor Envio (PAC / SEDEX) ---
# Client ID e Secret do app em melhorenvio.com.br → Integrações → Área Dev.
# No app, cadastre o callback: https://agilizapdv.app/api/loja-online/melhor-envio-callback
# Em Loja online → Entrega e frete, clique em Conectar Melhor Envio.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# MELHOR_ENVIO_REDIRECT_URI=https://agilizapdv.app/api/loja-online/melhor-envio-callback
# MELHOR_ENVIO_SANDBOX=0
#
# Fallback opcional (se não usar o botão Conectar): token Bearer da Área Dev
# MELHOR_ENVIO_TOKEN=seu-token-bearer
# MELHOR_ENVIO_REFRESH_TOKEN=
#
# SQL: web/sql/supabase-loja-online-melhor-envio.sql

# --- Loja online — Meta Ads (OAuth + Insights na Dashboard) ---
# App em developers.facebook.com com Marketing API. Callback:
# https://agilizapdv.app/api/loja-online/meta-callback
# Scopes: ads_read, ads_management, business_management
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI=https://agilizapdv.app/api/loja-online/meta-callback
#
# SQL: web/sql/supabase-loja-online-analytics.sql

# SQL do painel SaaS (copiar no Supabase > SQL Editor):
#   sql/supabase-saas-resumo.sql
#   sql/supabase-saas-planos.sql
#   sql/supabase-saas-excluir-empresa.sql
#   sql/supabase-assinaturas.sql
#   sql/supabase-assinaturas-empresas-existentes.sql  (opcional, empresas antigas)
